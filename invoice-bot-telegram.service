[Unit]
Description=Invoice Bot — Telegram long-polling bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/cyrilghali/repos/invoice-bot
ExecStart=/usr/bin/python3 -m sources.telegram_bot
EnvironmentFile=/home/cyrilghali/repos/invoice-bot/.env
Environment=PATH=/home/cyrilghali/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/home/cyrilghali/repos/invoice-bot/src
Environment=PYTHONUNBUFFERED=1

# Auto-restart on any failure, with increasing delay
Restart=on-failure
RestartSec=10

# Crash-loop protection: max 5 starts within 3 minutes, then stop trying
StartLimitBurst=5
StartLimitIntervalSec=180

[Install]
WantedBy=default.target

# Secrets — copy this file to .env and fill in your values.
# .env is gitignored and injected into the container by Docker Compose.

# Azure App Registration Client ID
# Get this from portal.azure.com > App registrations > Your app > Overview
AZURE_CLIENT_ID=

# Anthropic API key — no longer needed when using claude CLI mode.
# The classifier now uses `claude -p` which authenticates via your Claude subscription.
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (for invoice-bot-whatsapp.service)
# Get these from developers.facebook.com → your app → WhatsApp → API Setup.
# ---------------------------------------------------------------------------
# Permanent System User token (not the 24h temp token)
WHATSAPP_ACCESS_TOKEN=
# Arbitrary string you invent; you'll paste the same value into Meta's
# "Verify token" field when registering the webhook URL.
WHATSAPP_VERIFY_TOKEN=
# App Secret from Meta dashboard → App Settings → Basic → App Secret.
# Used to verify X-Hub-Signature-256 on incoming POSTs.
WHATSAPP_APP_SECRET=

# Secrets — copy this file to .env and fill in your values.
# .env is gitignored.

# Azure App Registration Client ID
# Get this from portal.azure.com > App registrations > Your app > Overview
AZURE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Telegram bot (for invoice-bot-telegram.service)
# Get this from @BotFather on Telegram: /newbot → pick name → copy token.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ID that receives OnFailure= crash alerts.
# Find yours by messaging @userinfobot. Leave blank to disable alerts.
TELEGRAM_ADMIN_CHAT_ID=
